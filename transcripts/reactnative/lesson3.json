			"text": " caused noticeable lag"
		},
		{
			"timestamps": {
				"from": "00:02:51,280",
				"to": "00:02:53,280"
			},
			"offsets": {
				"from": 171280,
				"to": 173280
			},
			"text": " and became a massive performance bottleneck"
		},
		{
			"timestamps": {
				"from": "00:02:53,280",
				"to": "00:02:55,200"
			},
			"offsets": {
				"from": 173280,
				"to": 175200
			},
			"text": " for anything involving heavy data."
		},
		{
			"timestamps": {
				"from": "00:02:55,200",
				"to": "00:02:56,160"
			},
			"offsets": {
				"from": 175200,
				"to": 176160
			},
			"text": " Think of it like this."
		},
		{
			"timestamps": {
				"from": "00:02:56,160",
				"to": "00:02:58,760"
			},
			"offsets": {
				"from": 176160,
				"to": 178760
			},
			"text": " It's essentially a slow translator."
		},
		{
			"timestamps": {
				"from": "00:02:58,760",
				"to": "00:03:01,120"
			},
			"offsets": {
				"from": 178760,
				"to": 181120
			},
			"text": " Imagine two people who literally don't speak a word"
		},
		{
			"timestamps": {
				"from": "00:03:01,120",
				"to": "00:03:04,040"
			},
			"offsets": {
				"from": 181120,
				"to": 184040
			},
			"text": " of the same language trying to have a rapid fire conversation."
		},
		{
			"timestamps": {
				"from": "00:03:04,040",
				"to": "00:03:06,040"
			},
			"offsets": {
				"from": 184040,
				"to": 186040
			},
			"text": " They have to use a slow, written translator"
		},
		{
			"timestamps": {
				"from": "00:03:06,040",
				"to": "00:03:07,760"
			},
			"offsets": {
				"from": 186040,
				"to": 187760
			},
			"text": " to pass nodes back and forth."
		},
		{
			"timestamps": {
				"from": "00:03:07,760",
				"to": "00:03:09,240"
			},
			"offsets": {
				"from": 187760,
				"to": 189240
			},
			"text": " It works, sure."
		},
		{
			"timestamps": {
				"from": "00:03:09,240",
				"to": "00:03:11,800"
			},
			"offsets": {
				"from": 189240,
				"to": 191800
			},
			"text": " But if you're trying to coordinate something incredibly fast"
		},
		{
			"timestamps": {
				"from": "00:03:11,800",
				"to": "00:03:15,040"
			},
			"offsets": {
				"from": 191800,
				"to": 195040
			},
			"text": " and complex, like a user swiping rapidly through a list,"
		},
		{
			"timestamps": {
				"from": "00:03:15,040",
				"to": "00:03:17,720"
			},
			"offsets": {
				"from": 195040,
				"to": 197720
			},
			"text": " that note passing delay creates stuttering."
		},
		{
			"timestamps": {
				"from": "00:03:17,720",
				"to": "00:03:20,120"
			},
			"offsets": {
				"from": 197720,
				"to": 200120
			},
			"text": " The user taps the screen, the note is passed,"
		},
		{
			"timestamps": {
				"from": "00:03:20,120",
				"to": "00:03:21,480"
			},
			"offsets": {
				"from": 200120,
				"to": 201480
			},
			"text": " the native side reacts,"
		},
		{
			"timestamps": {
				"from": "00:03:21,480",
				"to": "00:03:24,720"
			},
			"offsets": {
				"from": 201480,
				"to": 204720
			},
			"text": " but by then the moment has passed and you get a dropped frame."
		},
		{
			"timestamps": {
				"from": "00:03:24,720",
				"to": "00:03:28,560"
			},
			"offsets": {
				"from": 204720,
				"to": 208560
			},
			"text": " All right, section three, the new architecture paradigm."
		},
		{
			"timestamps": {
				"from": "00:03:28,560",
				"to": "00:03:29,400"
			},
			"offsets": {
				"from": 208560,
				"to": 209400
			},
			"text": " But guess what?"
		},
		{
			"timestamps": {
				"from": "00:03:29,400",
				"to": "00:03:32,880"
			},
			"offsets": {
				"from": 209400,
				"to": 212880
			},
			"text": " That era of slow translation is officially over."
		},
		{
			"timestamps": {
				"from": "00:03:32,880",
				"to": "00:03:34,440"
			},
			"offsets": {
				"from": 212880,
				"to": 214440
			},
			"text": " And I cannot stress this enough."
		},
		{
			"timestamps": {
				"from": "00:03:34,440",
				"to": "00:03:36,480"
			},
			"offsets": {
				"from": 214440,
				"to": 216480
			},
			"text": " This isn't just an incremental update."
		},
		{
			"timestamps": {
				"from": "00:03:36,480",
				"to": "00:03:39,000"
			},
			"offsets": {
				"from": 216480,
				"to": 219000
			},
			"text": " This is a massive, fundamental overhaul"
		},
		{
			"timestamps": {
				"from": "00:03:39,000",
				"to": "00:03:41,520"
			},
			"offsets": {
				"from": 219000,
				"to": 221520
			},
			"text": " of how React Native operates from the ground up,"
		},
		{
			"timestamps": {
				"from": "00:03:41,520",
				"to": "00:03:43,640"
			},
			"offsets": {
				"from": 221520,
				"to": 223640
			},
			"text": " and it changes absolutely everything"
		},
		{
			"timestamps": {
				"from": "00:03:43,640",
				"to": "00:03:45,520"
			},
			"offsets": {
				"from": 223640,
				"to": 225520
			},
			"text": " about cross-platform performance."
		},
		{
			"timestamps": {
				"from": "00:03:45,520",
				"to": "00:03:46,920"
			},
			"offsets": {
				"from": 225520,
				"to": 226920
			},
			"text": " Now, what's really interesting"
		},
		{
			"timestamps": {
				"from": "00:03:46,920",
				"to": "00:03:48,360"
			},
			"offsets": {
				"from": 226920,
				"to": 228360
			},
			"text": " about the contrast we're looking at here"
		},
		{
			"timestamps": {
				"from": "00:03:48,360",
				"to": "00:03:50,080"
			},
			"offsets": {
				"from": 228360,
				"to": 230080
			},
			"text": " is how stark it is."
		},
		{
			"timestamps": {
				"from": "00:03:50,080",
				"to": "00:03:52,080"
			},
			"offsets": {
				"from": 230080,
				"to": 232080
			},
			"text": " With the old system, you were heavily relying"
		},
		{
			"timestamps": {
				"from": "00:03:52,080",
				"to": "00:03:54,640"
			},
			"offsets": {
				"from": 232080,
				"to": 234640
			},
			"text": " on that asynchronous bridge and JSON serialization."
		},
		{
			"timestamps": {
				"from": "00:03:54,640",
				"to": "00:03:56,120"
			},
			"offsets": {
				"from": 234640,
				"to": 236120
			},
			"text": " But with the new architecture,"
		},
		{
			"timestamps": {
				"from": "00:03:56,120",
				"to": "00:03:58,720"
			},
			"offsets": {
				"from": 236120,
				"to": 238720
			},
			"text": " it's completely gone, replaced entirely."
		},
		{
			"timestamps": {
				"from": "00:03:58,720",
				"to": "00:04:00,960"
			},
			"offsets": {
				"from": 238720,
				"to": 240960
			},
			"text": " The framework now relies on direct synchronous"
		},
		{
			"timestamps": {
				"from": "00:04:00,960",
				"to": "00:04:02,600"
			},
			"offsets": {
				"from": 240960,
				"to": 242600
			},
			"text": " C++ communication."
		},
		{
			"timestamps": {
				"from": "00:04:02,600",
				"to": "00:04:05,120"
			},
			"offsets": {
				"from": 242600,
				"to": 245120
			},
			"text": " So JavaScript can talk directly to native modules"
		},
		{
			"timestamps": {
				"from": "00:04:05,120",
				"to": "00:04:06,720"
			},
			"offsets": {
				"from": 245120,
				"to": 246720
			},
			"text": " without having to translate its intent"
		},
		{
			"timestamps": {
				"from": "00:04:06,720",
				"to": "00:04:08,320"
			},
			"offsets": {
				"from": 246720,
				"to": 248320
			},
			"text": " into a giant string first."
		},
		{
			"timestamps": {
				"from": "00:04:08,320",
				"to": "00:04:09,840"
			},
			"offsets": {
				"from": 248320,
				"to": 249840
			},
			"text": " It's a real game changer."
		},
		{
			"timestamps": {
				"from": "00:04:09,840",
				"to": "00:04:12,840"
			},
			"offsets": {
				"from": 249840,
				"to": 252840
			},
			"text": " So how exactly do they achieve this massive leap?"
		},
		{
			"timestamps": {
				"from": "00:04:12,840",
				"to": "00:04:15,040"
			},
			"offsets": {
				"from": 252840,
				"to": 255040
			},
			"text": " Well, it boils down to a clear roadmap"
		},
		{
			"timestamps": {
				"from": "00:04:15,040",
				"to": "00:04:17,280"
			},
			"offsets": {
				"from": 255040,
				"to": 257280
			},
			"text": " consisting of three core pillars."
		},
		{
			"timestamps": {
				"from": "00:04:17,280",
				"to": "00:04:20,320"
			},
			"offsets": {
				"from": 257280,
				"to": 260320
			},
			"text": " First up, JSI, or the JavaScript interface."
		},
		{
			"timestamps": {
				"from": "00:04:20,320",
				"to": "00:04:23,680"
			},
			"offsets": {
				"from": 260320,
				"to": 263680
			},
			"text": " Second, turbo modules, and third, fabric."
		},
		{
			"timestamps": {
				"from": "00:04:23,680",
				"to": "00:04:26,200"
			},
			"offsets": {
				"from": 263680,
				"to": 266200
			},
			"text": " These three structural upgrades work together"
		},
		{
			"timestamps": {
				"from": "00:04:26,200",
				"to": "00:04:28,120"
			},
			"offsets": {
				"from": 266200,
				"to": 268120
			},
			"text": " to basically dynamite the old bridge"
		},
		{
			"timestamps": {
				"from": "00:04:28,120",
				"to": "00:04:31,040"
			},
			"offsets": {
				"from": 268120,
				"to": 271040
			},
			"text": " and unlock that highly sought after native level speed."
		},
		{
			"timestamps": {
				"from": "00:04:31,040",
				"to": "00:04:32,320"
			},
			"offsets": {
				"from": 271040,
				"to": 272320
			},
			"text": " Let's break them down."
		},
		{
			"timestamps": {
				"from": "00:04:32,320",
				"to": "00:04:37,040"
			},
			"offsets": {
				"from": 272320,
				"to": 277040
			},
			"text": " Section four, JSI direct code communication."
		},
		{
			"timestamps": {
				"from": "00:04:37,040",
				"to": "00:04:39,800"
			},
			"offsets": {
				"from": 277040,
				"to": 279800
			},
			"text": " Now, this is the first and arguably the most critical pillar"
		},
		{
			"timestamps": {
				"from": "00:04:39,800",
				"to": "00:04:41,520"
			},
			"offsets": {
				"from": 279800,
				"to": 281520
			},
			"text": " because it fundamentally rewrites"
		},
		{
			"timestamps": {
				"from": "00:04:41,520",
				"to": "00:04:43,560"
			},
			"offsets": {
				"from": 281520,
				"to": 283560
			},
			"text": " how the framework's core operates."
		},
		{
			"timestamps": {
				"from": "00:04:43,560",
				"to": "00:04:45,960"
			},
			"offsets": {
				"from": 283560,
				"to": 285960
			},
			"text": " JSI stands for JavaScript interface."
		},
		{
			"timestamps": {
				"from": "00:04:45,960",
				"to": "00:04:49,520"
			},
			"offsets": {
				"from": 285960,
				"to": 289520
			},
			"text": " It's a brand new layer that entirely replaces the old bridge."
		},
		{
			"timestamps": {
				"from": "00:04:49,520",
				"to": "00:04:52,400"
			},
			"offsets": {
				"from": 289520,
				"to": 292400
			},
			"text": " It allows JavaScript to hold actual direct references"
		},
		{
			"timestamps": {
				"from": "00:04:52,400",
				"to": "00:04:55,600"
			},
			"offsets": {
				"from": 292400,
				"to": 295600
			},
			"text": " to native C++ elements, which are known as host objects,"
		},
		{
			"timestamps": {
				"from": "00:04:55,600",
				"to": "00:04:58,280"
			},
			"offsets": {
				"from": 295600,
				"to": 298280
			},
			"text": " and communicate directly with native code."
		},
		{
			"timestamps": {
				"from": "00:04:58,280",
				"to": "00:05:01,000"
			},
			"offsets": {
				"from": 298280,
				"to": 301000
			},
			"text": " Essentially, JSI is like giving JavaScript and native code"
		},
		{
			"timestamps": {
				"from": "00:05:01,000",
				"to": "00:05:03,720"
			},
			"offsets": {
				"from": 301000,
				"to": 303720
			},
			"text": " the ability to finally speak the same language fluently."
		},
		{
			"timestamps": {
				"from": "00:05:03,720",
				"to": "00:05:06,040"
			},
			"offsets": {
				"from": 303720,
				"to": 306040
			},
			"text": " No more passing written notes through a slow translator."
		},
		{
			"timestamps": {
				"from": "00:05:06,040",
				"to": "00:05:08,040"
			},
			"offsets": {
				"from": 306040,
				"to": 308040
			},
			"text": " They can invoke each other's methods synchronously."
		},
		{
			"timestamps": {
				"from": "00:05:08,040",
				"to": "00:05:10,640"
			},
			"offsets": {
				"from": 308040,
				"to": 310640
			},
			"text": " It instantly strips away that entire slow serialization"
		},
		{
			"timestamps": {
				"from": "00:05:10,640",
				"to": "00:05:11,800"
			},
			"offsets": {
				"from": 310640,
				"to": 311800
			},
			"text": " process."
		},
		{
			"timestamps": {
				"from": "00:05:11,800",
				"to": "00:05:16,440"
			},
			"offsets": {
				"from": 311800,
				"to": 316440
			},
			"text": " Moving right along to section five, turbo modules, and fabric."
		},
		{
			"timestamps": {
				"from": "00:05:16,440",
				"to": "00:05:19,000"
			},
			"offsets": {
				"from": 316440,
				"to": 319000
			},
			"text": " So with JSI laying the foundation"
		},
		{
			"timestamps": {
				"from": "00:05:19,000",
				"to": "00:05:21,160"
			},
			"offsets": {
				"from": 319000,
				"to": 321160
			},
			"text": " for direct instant communication,"
		},
		{
			"timestamps": {
				"from": "00:05:21,160",
				"to": "00:05:24,280"
			},
			"offsets": {
				"from": 321160,
				"to": 324280
			},
			"text": " the framework can now optimize exactly when and how things load"
		},
		{
			"timestamps": {
				"from": "00:05:24,280",
				"to": "00:05:25,920"
			},
			"offsets": {
				"from": 324280,
				"to": 325920
			},
			"text": " and render on the screen."
		},
		{
			"timestamps": {
				"from": "00:05:25,920",
				"to": "00:05:28,520"
			},
			"offsets": {
				"from": 325920,
				"to": 328520
			},
			"text": " The crucial point here is how this heavily impacts"
		},
		{
			"timestamps": {
				"from": "00:05:28,520",
				"to": "00:05:30,240"
			},
			"offsets": {
				"from": 328520,
				"to": 330240
			},
			"text": " your app's startup times."
		},
		{
			"timestamps": {
				"from": "00:05:30,240",
				"to": "00:05:33,040"
			},
			"offsets": {
				"from": 330240,
				"to": 333040
			},
			"text": " In the old system, native modules practically force the app"
		},
		{
			"timestamps": {
				"from": "00:05:33,040",
				"to": "00:05:35,200"
			},
			"offsets": {
				"from": 333040,
				"to": 335200
			},
			"text": " to load everything right at startup."
		},
		{
			"timestamps": {
				"from": "00:05:35,200",
				"to": "00:05:37,800"
			},
			"offsets": {
				"from": 335200,
				"to": 337800
			},
			"text": " If your app had a Bluetooth module, a camera module,"
		},
		{
			"timestamps": {
				"from": "00:05:37,800",
				"to": "00:05:40,640"
			},
			"offsets": {
				"from": 337800,
				"to": 340640
			},
			"text": " and a geolocation module, well, they all initialize"
		},
		{
			"timestamps": {
				"from": "00:05:40,640",
				"to": "00:05:41,760"
			},
			"offsets": {
				"from": 340640,
				"to": 341760
			},
			"text": " when the app opened."
		},
		{
			"timestamps": {
				"from": "00:05:41,760",
				"to": "00:05:44,000"
			},
			"offsets": {
				"from": 341760,
				"to": 344000
			},
			"text": " Even if the user just wanted to read a text article,"
		},
		{
			"timestamps": {
				"from": "00:05:44,000",
				"to": "00:05:45,560"
			},
			"offsets": {
				"from": 344000,
				"to": 345560
			},
			"text": " it was so inefficient."
		},
		{
			"timestamps": {
				"from": "00:05:45,560",
				"to": "00:05:48,200"
			},
			"offsets": {
				"from": 345560,
				"to": 348200
			},
			"text": " Turbo modules fix this flaw entirely."
		},
