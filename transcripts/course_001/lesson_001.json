	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:04,580"
			},
			"offsets": {
				"from": 0,
				"to": 4580
			},
			"text": " The React Native Bridge is the secret to building mobile apps in half the time."
		},
		{
			"timestamps": {
				"from": "00:00:04,580",
				"to": "00:00:07,800"
			},
			"offsets": {
				"from": 4580,
				"to": 7800
			},
			"text": " Historically, launching an app meant doing the work twice,"
		},
		{
			"timestamps": {
				"from": "00:00:07,800",
				"to": "00:00:12,200"
			},
			"offsets": {
				"from": 7800,
				"to": 12200
			},
			"text": " writing one codebase for Apple, and a completely separate one for Android."
		},
		{
			"timestamps": {
				"from": "00:00:12,200",
				"to": "00:00:15,800"
			},
			"offsets": {
				"from": 12200,
				"to": 15800
			},
			"text": " Take a standard \"Submit\" button on a new app's login screen."
		},
		{
			"timestamps": {
				"from": "00:00:15,800",
				"to": "00:00:19,800"
			},
			"offsets": {
				"from": 15800,
				"to": 19800
			},
			"text": " Normally, creating that single button requires writing platform-specific code"
		},
		{
			"timestamps": {
				"from": "00:00:19,800",
				"to": "00:00:22,600"
			},
			"offsets": {
				"from": 19800,
				"to": 22600
			},
			"text": " in two entirely different programming languages."
		},
		{
			"timestamps": {
				"from": "00:00:22,600",
				"to": "00:00:26,280"
			},
			"offsets": {
				"from": 22600,
				"to": 26280
			},
			"text": " But with React Native, a developer writes that button just once,"
		},
		{
			"timestamps": {
				"from": "00:00:26,280",
				"to": "00:00:29,400"
			},
			"offsets": {
				"from": 26280,
				"to": 29400
			},
			"text": " using a single, universal JavaScript component."
		},
		{
			"timestamps": {
				"from": "00:00:29,400",
				"to": "00:00:30,600"
			},
			"offsets": {
				"from": 29400,
				"to": 30600
			},
			"text": " Here's the problem."
		},
		{
			"timestamps": {
				"from": "00:00:30,600",
				"to": "00:00:34,000"
			},
			"offsets": {
				"from": 30600,
				"to": 34000
			},
			"text": " An iPhone cannot natively read JavaScript UI components,"
		},
		{
			"timestamps": {
				"from": "00:00:34,000",
				"to": "00:00:35,600"
			},
			"offsets": {
				"from": 34000,
				"to": 35600
			},
			"text": " and neither can an Android."
		},
		{
			"timestamps": {
				"from": "00:00:35,600",
				"to": "00:00:37,900"
			},
			"offsets": {
				"from": 35600,
				"to": 37900
			},
			"text": " So how does the button actually appear?"
		},
		{
			"timestamps": {
				"from": "00:00:37,900",
				"to": "00:00:40,400"
			},
			"offsets": {
				"from": 37900,
				"to": 40400
			},
			"text": " The framework runs the JavaScript in the background,"
		},
		{
			"timestamps": {
				"from": "00:00:40,400",
				"to": "00:00:44,400"
			},
			"offsets": {
				"from": 40400,
				"to": 44400
			},
			"text": " and uses a continuous communication channel to tell the phone's operating system"
		},
		{
			"timestamps": {
				"from": "00:00:44,400",
				"to": "00:00:46,000"
			},
			"offsets": {
				"from": 44400,
				"to": 46000
			},
			"text": " exactly what to draw."
		},
		{
			"timestamps": {
				"from": "00:00:46,000",
				"to": "00:00:47,500"
			},
			"offsets": {
				"from": 46000,
				"to": 47500
			},
			"text": " This is the bridge."
		},
		{
			"timestamps": {
				"from": "00:00:47,500",
				"to": "00:00:52,500"
			},
			"offsets": {
				"from": 47500,
				"to": 52500
			},
			"text": " That single line of JavaScript commands the iPhone to render its authentic iOS button,"
		},
		{
			"timestamps": {
				"from": "00:00:52,500",
				"to": "00:00:57,000"
			},
			"offsets": {
				"from": 52500,
				"to": 57000
			},
			"text": " while simultaneously commanding the Android to render its authentic Android button."
		},
		{
			"timestamps": {
				"from": "00:00:57,000",
				"to": "00:01:01,000"
			},
			"offsets": {
				"from": 57000,
				"to": 61000
			},
			"text": " So what happens to that standard login screen we needed to build at the very beginning?"
		},
		{
			"timestamps": {
				"from": "00:01:01,000",
				"to": "00:01:05,800"
			},
			"offsets": {
				"from": 61000,
				"to": 65800
			},
			"text": " It launches as a flawless native experience on both devices at the exact same time,"
		},
		{
			"timestamps": {
				"from": "00:01:05,800",
				"to": "00:01:08,000"
			},
			"offsets": {
				"from": 65800,
				"to": 68000
			},
			"text": " cutting the workload completely in half."
		}
	]
}
